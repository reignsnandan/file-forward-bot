API_ID=12345678
API_HASH=your_api_hash
BOT_TOKEN=123456:your_bot_token
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/
DB_NAME=file_forward_bot

# Telegram chat IDs. Multiple source chats can be comma-separated.
SOURCE_CHATS=-1001234567890
DESTINATION_CHAT=-1009876543210

# Telegram user IDs allowed to use private admin commands.
ADMIN_IDS=123456789

# Optional defaults. They can also be changed with bot commands.
PREFIX=[GOODMOVIES] 
CAPTION={caption}